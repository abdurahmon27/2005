# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# pagefind search index (generated during build)
/public/_pagefind/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The Quran part of the Arabic course is for personal study only and must never
# be published: Uzbek law (ZRU-699 art. 10) requires a religious expertise
# before religious material is distributed, the internet included.
/src/app/lab/quran/
/src/components/lab/arabic/quran/
/scripts/arabic/quran/
